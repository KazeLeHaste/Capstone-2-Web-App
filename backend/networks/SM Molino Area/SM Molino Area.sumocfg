<?xml version='1.0' encoding='utf-8'?>
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="SM Molino Area.net.xml.gz" />
        <route-files value="routes/osm.passenger.rou.xml,routes/osm.motorcycle.rou.xml,routes/osm.truck.rou.xml,routes/osm.bus.rou.xml" />
        <additional-files value="SM Molino Area.poly.add.xml,SM Molino Area.output_add.xml" />
    </input>
    <output>
        <emission-output value="SM Molino Area.SM%2520Molino%2520Area_emissions.xml" />
        <summary-output value="SM Molino Area.SM%2520Molino%2520Area_summary.xml" />
        <tripinfo-output value="SM Molino Area.tripinfos.xml" />
        <edgedata-output value="SM Molino Area.SM%2520Molino%2520Area_edgedata.xml" />
        <statistic-output value="SM Molino Area.stats.xml" />
    </output>
    <processing>
        <ignore-route-errors value="true" />
        <tls.actuated.jam-threshold value="30" />
    </processing>
    <routing>
        <device.rerouting.adaptation-steps value="18" />
        <device.rerouting.adaptation-interval value="10" />
    </routing>
    <report>
        <verbose value="true" />
        <duration-log.statistics value="true" />
        <no-step-log value="true" />
    </report>
    <gui_only>
        <gui-settings-file value="SM Molino Area.osm_view.xml" />
    </gui_only>
</sumoConfiguration>